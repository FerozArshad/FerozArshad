generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password for /admin dashboard
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  problem     String   @db.Text
  solution    String   @db.Text
  outcome     String   @db.Text
  role        String
  timeline    String
  techStack   String   // Stored as JSON string or comma-separated
  featured    Boolean  @default(false)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  icon        String?  // Tabler icon name
  features    String   @db.Text // Stored as JSON string
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Insight {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String
  // Legacy single-body field; new editor writes structured `sections` instead.
  // We keep this for backward compat with the 3 existing rows seeded before the
  // CMS upgrade. Public render falls back to `content` when `sections` is null.
  content     String    @db.Text
  excerpt     String?   @db.VarChar(500)
  // Multi-section editor payload — JSON array of { heading, body } objects.
  // Per Spenzio playbook (`04_BLOG_CMS_ADMIN_PORTAL.md`): plain text body,
  // rendered with whitespace-pre-line; do NOT use an HTML rich editor here.
  sections    Json?
  coverImage  String?   @db.VarChar(500) // Vercel Blob public URL
  coverAlt    String?   @db.VarChar(255)
  authorName  String?   @db.VarChar(100)
  authorRole  String?   @db.VarChar(150)
  readTime    String?   @db.VarChar(40)  // e.g. "7 min read"
  tags        String?   @db.VarChar(500) // comma-separated
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  service   String
  message   String   @db.Text
  createdAt DateTime @default(now())
}
