# ─── ferozarshad.com main site ────────────────────────────────────────────────
# Copy to .env and fill. NEVER commit .env.

# MySQL (Hostinger / PlanetScale / etc.)
DATABASE_URL="mysql://user:pass@host:3306/db?connection_limit=2"

# Zoho SMTP for contact-form delivery
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""        # Zoho app-specific password, NOT your account password
SMTP_TO=""          # Where leads are delivered

# Google Analytics (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXX"

# Google Tag Manager
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Google Search Console verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Prisma engine selection (leave as-is on Vercel)
PRISMA_CLIENT_ENGINE_TYPE=binary
